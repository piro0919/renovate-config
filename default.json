{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":timezone(Asia/Tokyo)"
  ],
  "schedule": ["every weekend"],
  "automerge": true,
  "platformAutomerge": true,
  "dependencyDashboard": true,
  "rangeStrategy": "bump",
  "minimumReleaseAge": "3 days",
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["before 5am on monday"]
  },
  "packageRules": [
    {
      "groupName": "devDependencies (minor/patch)",
      "matchDepTypes": ["devDependencies"],
      "matchUpdateTypes": ["minor", "patch", "pin", "digest"],
      "automerge": true
    },
    {
      "groupName": "dependencies (minor/patch)",
      "matchDepTypes": ["dependencies"],
      "matchUpdateTypes": ["minor", "patch", "pin", "digest"],
      "automerge": true
    },
    {
      "groupName": "serwist",
      "matchPackageNames": ["serwist", "@serwist/**"],
      "matchUpdateTypes": ["minor", "patch", "pin", "digest"],
      "automerge": true
    },
    {
      "groupName": "other major updates",
      "matchUpdateTypes": ["major"],
      "labels": ["dependencies", "major-update"],
      "automerge": false,
      "prPriority": 10
    },
    {
      "groupName": "Next.js major",
      "matchPackageNames": ["next", "@next/**"],
      "matchUpdateTypes": ["major"],
      "labels": ["dependencies", "nextjs", "major-update", "breaking-change"],
      "automerge": false,
      "prPriority": 20
    },
    {
      "groupName": "React major",
      "matchPackageNames": ["react", "react-dom", "@types/react", "@types/react-dom"],
      "matchUpdateTypes": ["major"],
      "labels": ["dependencies", "react", "major-update", "breaking-change"],
      "automerge": false,
      "prPriority": 20
    },
    {
      "groupName": "TypeScript major",
      "matchPackageNames": ["typescript", "@types/**"],
      "matchUpdateTypes": ["major"],
      "labels": ["dependencies", "typescript", "major-update"],
      "automerge": false,
      "prPriority": 15
    },
    {
      "groupName": "Tailwind major",
      "matchPackageNames": ["tailwindcss", "@tailwindcss/**"],
      "matchUpdateTypes": ["major"],
      "labels": ["dependencies", "tailwind", "major-update", "breaking-change"],
      "automerge": false
    },
    {
      "groupName": "Biome major",
      "matchPackageNames": ["@biomejs/biome"],
      "matchUpdateTypes": ["major"],
      "labels": ["dependencies", "biome", "major-update"],
      "automerge": false
    },
    {
      "groupName": "serwist major",
      "matchPackageNames": ["serwist", "@serwist/**"],
      "matchUpdateTypes": ["major"],
      "labels": ["dependencies", "serwist", "major-update", "breaking-change"],
      "automerge": false,
      "prPriority": 10
    },
    {
      "description": "Libraries publish peerDependencies as a promise of what they work with. Bumping would raise the floor to whatever came out last week and lock out every consumer below it, so peers only ever widen (e.g. ^18 || ^19 gains || ^20). App and dev dependencies keep the bump strategy above.",
      "matchDepTypes": ["peerDependencies"],
      "rangeStrategy": "widen"
    },
    {
      "description": "secretlint's release notes quote sample MongoDB connection strings from its test fixtures. Pasted into a PR body, they trip GitHub secret scanning in every repository that uses it.",
      "matchPackageNames": ["secretlint", "@secretlint/**"],
      "fetchChangeLogs": "off"
    }
  ]
}
